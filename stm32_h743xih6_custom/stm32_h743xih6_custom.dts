/dts-v1/;
#include <st/h7/stm32h743Xi.dtsi>
#include <st/h7/stm32h743xihx-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "STMicroelectronics Custom Board by lee";
	compatible = "st,stm32_h743xih6_custom";

	chosen {
		zephyr,console = &usart1;
		zephyr,shell-uart = &usart1;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,dtcm = &dtcm;
		zephyr,code-partition = &slot0_partition;
	};

	sdram1: sdram@c0000000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		device_type = "memory";
		reg = <0xc0000000 DT_SIZE_M(32)>;
		zephyr,memory-region = "SDRAM1";
		zephyr,memory-attr = <DT_MEM_ARM(ATTR_MPU_RAM)>;
	};
};

&clk_lsi {
	status = "okay";
};

&clk_hsi48 {
	status = "okay";
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(25)>;
	status = "okay";
};

&clk_lse {
	clock-frequency = <32768>;
	status = "okay";
};

&pll {
	div-m = <5>;
	mul-n = <192>;
	div-p = <2>;
	div-q = <2>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&pll2 {
	div-m = <16>;
	mul-n = <128>;
	div-p = <2>;
	div-q = <2>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&pll3 {
	div-m = <16>;
	mul-n = <128>;
	div-p = <2>;
	div-q = <2>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(480)>;
	d1cpre = <1>;
	hpre = <2>;
	d1ppre = <2>;
	d2ppre1 = <2>;
	d2ppre2 = <2>;
	d3ppre = <2>;
};

&pwr {
	power-supply = "ldo";
};

&dma1 {
	status = "okay";
};

&dma2 {
	status = "okay";
};

&dmamux1 {
	status = "okay";
};

&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&i2c1 {
	pinctrl-0 = <&i2c1_scl_pb8 &i2c1_sda_pb9>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;
	scl-gpios = <&gpiob 8 GPIO_ACTIVE_HIGH>;
	sda-gpios = <&gpiob 9 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&rtc {
	clocks = <&rcc STM32_CLOCK(APB4, 16)>,
		 <&rcc STM32_SRC_LSE RTC_SEL(1)>;
	status = "okay";
};

&flash0 {
	partitions {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* 128KB for bootloader */
		slot0_partition: partition@40000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x00040000 DT_SIZE_K(1792)>;
		};
	};
};

&fmc {
	status = "okay";
	pinctrl-0 = <&fmc_a0_pf0 
	             &fmc_a1_pf1 
				 &fmc_a2_pf2
				 &fmc_a3_pf3
				 &fmc_a4_pf4
				 &fmc_a5_pf5
				 &fmc_a6_pf12
				 &fmc_a7_pf13
				 &fmc_a8_pf14
				 &fmc_a9_pf15
				 &fmc_a10_pg0
				 &fmc_a11_pg1
				 &fmc_a12_pg2
				 &fmc_d0_pd14
				 &fmc_d1_pd15
				 &fmc_d2_pd0
				 &fmc_d3_pd1
				 &fmc_d4_pe7
				 &fmc_d5_pe8
				 &fmc_d6_pe9
				 &fmc_d7_pe10
				 &fmc_d8_pe11
				 &fmc_d9_pe12
				 &fmc_d10_pe13
				 &fmc_d11_pe14
				 &fmc_d12_pe15
				 &fmc_d13_pd8
				 &fmc_d14_pd9
				 &fmc_d15_pd10
				 &fmc_sdnwe_pc0
				 &fmc_sdncas_pg15
				 &fmc_sdnras_pf11
				 &fmc_sdne0_ph3
				 &fmc_a14_pg4
				 &fmc_a15_pg5
				 &fmc_sdcke0_ph2
				 &fmc_sdclk_pg8
				 &fmc_nbl1_pe1
				 &fmc_nbl0_pe0>;
	pinctrl-names = "default";

	sdram {
		status = "okay";
		//파워켜지는데 얼마나 기다려야 하는지
		power-up-delay = <100>;
		//초기 auto refresh 횟수
		num-auto-refresh = <2>;
		//h743은 burst length가 1임. (r/w burst length, read burst랑 다름)
		mode-register = <0x230>;
		//리프레시 요구사항 확인 - Datasheet에서 ms, 횟수 나오는데
		//계산 (ms/횟수) * SDRAM 클럭 주파수 의 반 내림
		// refresh-rate는 refresh를 최소한 refresh-rate 주기로 해야 한다는 것을 나타냄 
		refresh-rate = <917>;

		bank@0 {
			reg = <0>;

			st,sdram-control = <STM32_FMC_SDRAM_NC_9
								STM32_FMC_SDRAM_NR_13
								STM32_FMC_SDRAM_MWID_16
								STM32_FMC_SDRAM_NB_4
								STM32_FMC_SDRAM_CAS_3
								STM32_FMC_SDRAM_SDCLK_PERIOD_2
								STM32_FMC_SDRAM_RBURST_ENABLE
								STM32_FMC_SDRAM_RPIPE_0>;
			st,sdram-timing = <2 8 6 8 2 3 3>;
		};
	};
};

&sdmmc1 {
	pinctrl-0 = <&sdmmc1_d0_pc8
				 &sdmmc1_d1_pc9
				 &sdmmc1_d2_pc10
				 &sdmmc1_d3_pc11
				 &sdmmc1_cmd_pd2
				 &sdmmc1_ck_pc12>;
	pinctrl-names = "default";
	//클럭 sel 참조 -> RCC_D1CCIPR
	clocks = <&rcc STM32_CLOCK(AHB3, 16)>,
			<&rcc STM32_SRC_PLL2_R SDMMC_SEL(1)>;
	//dma 활성
	idma;
	//버스 폭 4비트
	bus-width = <4>;
	//클럭 디바이드 sdmmc_ker_clk/(2[기본 값 2] + 2)
	clk-div = <2>;
	//활성
	status = "okay";
	// 디스크 이름 설정
	disk-name = "SD1";
};